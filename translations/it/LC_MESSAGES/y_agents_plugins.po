msgstr "Messaggio standard"

#. manifest string
#: meta/registry.json/agent_types[4]/client_parameters[2]/description
msgid "Stop the persuasion thread once the target user's latest opinion is within this tolerance of the configured target value."
msgstr "Interrompe il thread di persuasione quando l'ultima opinione dell'utente bersaglio rientra in questa tolleranza rispetto al valore obiettivo configurato."

#. manifest string
#: meta/registry.json/agent_types[4]/client_parameter_sections[1]/description
msgid "Stopping conditions and adaptation sensitivity for persuasion threads."
msgstr "Condizioni di arresto e sensibilità di adattamento dei thread di persuasione."

#. manifest string
#: meta/registry.json/agent_types[0]/display_name
msgid "Stress Attacker"
msgstr "Stress Attacker"

#. manifest string
#: meta/registry.json/agent_types[0]/client_parameter_sections[1]/label
msgid "Stress Campaign"
msgstr "Campagna di stress"

#. manifest string
#: meta/registry.json/agent_types[5]/parameters[5]/label
msgid "Support Budget Percentage"
msgstr "Percentuale di budget per il supporto"

#. manifest string
#: meta/registry.json/agent_types[0]/client_parameters[9]/description
msgid "Synthetic comment body used when Critical Comment Mode is synthetic. The target tag is added automatically at the beginning of the reply."
msgstr "Testo del commento sintetico usato quando la modalità dei commenti critici è sintetica. Il tag del bersaglio viene aggiunto in automatico all'inizio della risposta."

#. manifest string
#: meta/registry.json/agent_types[0]/client_parameter_sections[3]/description
msgid "Synthetic critical-comment events that increase stress without generating abusive text."
msgstr "Eventi sintetici di commenti critici che aumentano lo stress senza generare testi offensivi."

#. manifest string
#: meta/registry.json/agent_types[0]/client_parameter_sections[2]/description
msgid "Synthetic dislike bursts applied to a recent post from the selected target."
msgstr "Raffiche sintetiche di non mi piace applicate a un post recente del bersaglio selezionato."

#. manifest string
#: meta/registry.json/agent_types[0]/client_parameters[6]/description
msgid "Synthetic dislike volume used when negative reactions are enabled."
msgstr "Volume dei non mi piace sintetici usato quando le reazioni negative sono abilitate."

#. manifest string
#: meta/registry.json/agent_types[0]/client_parameters[3]/description
msgid "Synthetic number of coordinated sources represented in each burst."
msgstr "Numero sintetico di fonti coordinate rappresentate in ogni raffica."

#. manifest string
#: meta/registry.json/agent_types[0]/client_parameters[11]/description
msgid "Synthetic number of reports generated during each report burst."
msgstr "Numero sintetico di segnalazioni generate durante ogni raffica di segnalazioni."

#. manifest string
#: meta/registry.json/agent_types[0]/client_parameter_sections[4]/description
msgid "Synthetic report bursts inserted against the selected target's recent post."
msgstr "Raffiche sintetiche di segnalazioni inserite contro il post recente del bersaglio selezionato."

#. manifest string
#: meta/registry.json/agent_types[0]/client_parameters[0]/label
msgid "Target Filters"
msgstr "Filtri sui bersagli"

#. manifest string
#: meta/registry.json/agent_types[0]/client_parameter_sections[0]/label
msgid "Target Selection"
msgstr "Selezione del bersaglio"

#. manifest string
#: meta/registry.json/agent_types[4]/description
msgid "Targets regular agents on configured opinion-dynamics topics, opens tagged persuasion threads, and adapts its nudging strategy based on observed opinion shifts over time."
msgstr "Prende di mira agenti normali sugli argomenti di dinamica delle opinioni configurati, apre thread di persuasione con tag e adatta la strategia di spinta in base ai cambiamenti di opinione osservati nel tempo."

#. manifest string
#: meta/registry.json/agent_types[3]/parameters[3]/label
msgid "Toxicity Threshold"
msgstr "Soglia di tossicità"

